# Hugging Face Hub (Optional, helpful for dataset download rate limits)
HF_TOKEN=your_huggingface_token_here

# Speech-to-Text (STT) and Voice Services
# The task requires using either Sarvam or ElevenLabs
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Large Language Model (LLM) Candidate Provider Keys (to be benchmarked)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vector Database Credentials (to be selected in the next phase)
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your_vector_db_key_here
