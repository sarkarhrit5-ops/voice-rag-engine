# Hugging Face Hub (Optional, helpful for dataset download rate limits)
HF_TOKEN=your_huggingface_token_here

# Speech-to-Text (STT) and Voice Services
# Sarvam AI Configuration
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=hi-IN
SARVAM_STT_TIMEOUT_SECONDS=30
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_LANGUAGE_CODE=hi-IN
SARVAM_TTS_TIMEOUT_SECONDS=30
# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Large Language Model (LLM) Candidate Provider Keys (to be benchmarked)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=mock
LLM_MODEL=mock-low-latency

# Vector Database Credentials (to be selected in the next phase)
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your_vector_db_key_here

# Production API
VOICE_RAG_API_HOST=127.0.0.1
VOICE_RAG_API_PORT=8000
# Frontend public API URL. Vite reads VITE_* variables at startup, so restart
# the frontend dev server after changing this. Do not put secrets in VITE_*.
VITE_VOICE_RAG_API_URL=http://127.0.0.1:8000
VOICE_RAG_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
VOICE_RAG_ENABLE_TTS=false
TTS_ENABLED=false
VOICE_RAG_MAX_UPLOAD_MB=10
VOICE_RAG_REQUEST_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=10
VOICE_RAG_TEMP_DIR=

# Local multilingual retrieval (AI4Bharat MSMARCO-XI)
# The dataset is local. Ingestion must not use Hugging Face streaming.
MSMARCO_XI_DATASET_PATH=D:\MSMARCO-XI
MSMARCO_XI_SPLIT=train
MSMARCO_XI_INDEX_ROOT=retrieval/indexes
MSMARCO_XI_BATCH_SIZE=64
# Legacy single-index override; leave blank for language-specific indexes.
MSMARCO_XI_INDEX_DIR=
